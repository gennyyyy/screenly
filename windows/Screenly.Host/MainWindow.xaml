<Window x:Class="Screenly.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenly" Height="400" Width="500">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Screenly" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontFamily="Consolas" />
        </StackPanel>
    </Grid>
</Window>
